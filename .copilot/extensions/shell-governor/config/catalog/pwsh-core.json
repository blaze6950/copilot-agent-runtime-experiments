{
  "kind": "pwsh-core",
  "source": "core PowerShell report (S4): verb table (Get-Verb groups), noun exceptions, .NET table, cmd table, dynamic rules. Fixes: Write-Host strings are not paths; Start-Sleep/Import-Csv/Add-Member/New-Object (non-COM) = read; Remove-Item = delete; Copy/Move/Rename split source/destination; Invoke-RestMethod GET = read-remote; -OutFile = download; -Method POST/PUT/PATCH or -Body = remote-write",
  "verbs": {
    "read": ["get", "find", "search", "test", "measure", "compare", "resolve", "select", "format", "group", "join", "split", "sort", "where", "foreach", "convertfrom", "convertto", "out", "write", "import", "exit", "confirm", "sleep"],
    "write": ["set", "new", "add", "copy", "move", "rename", "clear", "export", "expand", "compress", "update", "save", "edit", "sync", "backup", "checkpoint", "restore", "merge"],
    "delete": ["remove", "unpublish"],
    "execute-code": ["start", "invoke", "enter", "step", "use", "build", "deploy", "submit", "wait", "trace", "debug"],
    "publish": ["publish", "send"],
    "persistence": ["install", "uninstall", "register", "unregister", "enable", "disable"],
    "privilege": ["grant", "revoke", "block", "unblock", "protect", "unprotect", "lock", "unlock", "approve", "deny"],
    "system": ["initialize", "optimize", "repair", "reset", "mount", "dismount"]
  },
  "exact": {
    "start-sleep": "read", "import-csv": "read", "import-clixml": "read", "import-powershelldatafile": "read",
    "out-null": "read", "out-string": "read", "out-host": "read", "write-host": "read", "write-output": "read",
    "write-verbose": "read", "write-warning": "read", "write-error": "read", "write-progress": "read",
    "write-information": "read", "write-debug": "read", "stop-transcript": "read", "start-transcript": "write",
    "measure-command": "read", "add-member": "read", "new-object": "read", "set-variable": "read", "new-variable": "read",
    "get-variable": "read", "remove-variable": "delete", "set-strictmode": "read", "set-alias": "unknown", "new-alias": "unknown",
    "set-location": "read", "push-location": "read", "pop-location": "read", "cd": "read", "sl": "read",
    "pushd": "read", "popd": "read", "join-string": "read", "test-netconnection": "read-remote",
    "test-connection": "read-remote", "resolve-dnsname": "read-remote", "get-date": "read", "get-command": "read",
    "get-member": "read", "get-process": "read", "get-ciminstance": "read", "compare-object": "read",
    "group-object": "read", "measure-object": "read", "select-string": "read", "tee-object": "read",
    "out-file": "write", "export-csv": "write", "export-clixml": "write", "set-content": "write", "add-content": "write",
    "clear-content": "write", "new-item": "write", "copy-item": "write", "move-item": "write", "rename-item": "write",
    "set-item": "write", "set-itemproperty": "write", "new-itemproperty": "write", "remove-itemproperty": "delete",
    "remove-item": "delete", "clear-recyclebin": "delete", "expand-archive": "write", "compress-archive": "write",
    "add-type": "execute-code", "start-process": "execute-code", "start-job": "execute-code",
    "stop-process": "unknown", "invoke-expression": "dynamic", "iex": "dynamic", "invoke-command": "unknown",
    "enter-pssession": "unknown", "new-pssession": "unknown", "invoke-cimmethod": "unknown", "invoke-wmimethod": "unknown",
    "import-module": "execute-code", "invoke-item": "execute-code", "get-clipboard": "unknown", "set-clipboard": "unknown",
    "get-credential": "credential", "convertfrom-securestring": "credential", "get-azaccesstoken": "credential",
    "get-azkeyvaultsecret": "credential", "get-azkeyvaultkey": "credential", "get-azstorageaccountkey": "credential",
    "get-azrediscachekey": "credential", "get-azservicebuskey": "credential",
    "get-azeventhubkey": "credential", "get-azcosmosdbaccountkey": "credential", "get-azcognitiveservicesaccountkey": "credential",
    "get-azsearchadminkey": "credential", "get-azwebapppublishingprofile": "credential", "get-azpublishingprofile": "credential",
    "get-azautomationcredential": "credential",
    "get-pnpaccesstoken": "credential", "get-mgaccesstoken": "credential", "get-storedcredential": "credential",
    "new-azstorageaccountsastoken": "credential", "new-azstoragecontainersastoken": "credential", "new-azstorageblobsastoken": "credential",
    "install-module": "install", "install-package": "install", "install-script": "install",
    "uninstall-module": "install", "save-module": "install", "update-help": "install", "save-help": "unknown",
    "set-executionpolicy": "privilege", "set-acl": "privilege", "unblock-file": "privilege", "new-localuser": "privilege",
    "add-localgroupmember": "privilege", "stop-computer": "system", "restart-computer": "system", "format-volume": "system",
    "clear-disk": "system", "initialize-disk": "system", "remove-partition": "system", "new-netfirewallrule": "system",
    "set-netfirewallprofile": "system", "disable-netfirewallrule": "system", "set-netipaddress": "system",
    "set-dnsclientserveraddress": "system", "register-scheduledtask": "persistence", "new-scheduledtask": "persistence",
    "new-service": "persistence", "set-service": "persistence", "start-service": "unknown", "stop-service": "unknown",
    "restart-service": "unknown", "invoke-restmethod": "read-remote", "invoke-webrequest": "read-remote",
    "start-bitstransfer": "download", "get-filehash": "read", "get-content": "read", "get-childitem": "read",
    "get-item": "read", "get-itemproperty": "read", "get-acl": "read", "test-path": "read", "resolve-path": "read",
    "split-path": "read", "join-path": "read", "get-location": "read", "select-object": "read", "where-object": "read",
    "foreach-object": "read", "sort-object": "read", "format-table": "read", "format-list": "read", "format-custom": "read",
    "convertfrom-json": "read", "convertto-json": "read", "convertfrom-csv": "read", "convertto-csv": "read",
    "get-random": "read", "get-host": "read", "get-verb": "read", "get-alias": "read", "get-help": "read",
    "get-module": "read", "get-service": "read", "get-psdrive": "read", "select-xml": "read", "read-host": "unknown",
    "exit": "read", "confirm": "read"
  },
  "overrides": [
    { "cmd": "invoke-restmethod", "anyParam": ["outfile"], "class": "download" },
    { "cmd": "invoke-webrequest", "anyParam": ["outfile"], "class": "download" },
    { "cmd": "invoke-restmethod", "paramValueIn": { "method": ["post", "put", "patch"] }, "class": "remote-write" },
    { "cmd": "invoke-webrequest", "paramValueIn": { "method": ["post", "put", "patch"] }, "class": "remote-write" },
    { "cmd": "invoke-restmethod", "paramValueIn": { "method": ["delete"] }, "class": "remote-destructive" },
    { "cmd": "invoke-webrequest", "paramValueIn": { "method": ["delete"] }, "class": "remote-destructive" },
    { "cmd": "invoke-restmethod", "anyParam": ["body"], "class": "remote-write" },
    { "cmd": "invoke-webrequest", "anyParam": ["body"], "class": "remote-write" },
    { "cmd": "tee-object", "anyParam": ["filepath"], "class": "write" },
    { "cmd": "start-process", "anyParam": ["verb"], "class": "privilege" },
    { "cmd": "new-object", "wordRegex": "net\\.(webclient|httpclient|sockets|tcpclient)", "class": "unknown" },
    { "cmd": "new-object", "wordRegex": "diagnostics\\.process(startinfo)?$", "class": "unknown" },
    { "cmd": "new-object", "anyParam": ["comobject"], "class": "unknown" },
    { "cmd": "new-item", "paramValueIn": { "itemtype": ["symboliclink", "junction", "hardlink"] }, "class": "unknown" },
    { "cmd": "set-location", "class": "read" }
  ],
  "namePrefixOverrides": [
    { "prefix": "get-secret", "class": "credential" },
    { "prefix": "set-secret", "class": "write" }
  ],
  "dotnet": [
    { "match": "math::*", "class": "read" },
    { "match": "system.math::*", "class": "read" },
    { "match": "regex::*", "class": "read" },
    { "match": "convert::*", "class": "read" },
    { "match": "system.convert::*", "class": "read" },
    { "match": "*text.encoding::*", "class": "read" },
    { "match": "*datetime*::*", "class": "read" },
    { "match": "*guid::newguid", "class": "read" },
    { "match": "*web.httputility::urlencode", "class": "read" },
    { "match": "*io.path::combine", "class": "read" },
    { "match": "*io.path::gettemppath", "class": "read" },
    { "match": "*io.path::gettempfilename", "class": "write-temp" },
    { "match": "*io.file::readall*", "class": "read", "dynamicPath": true },
    { "match": "*io.file::exists", "class": "read", "dynamicPath": true },
    { "match": "*io.file::writeall*", "class": "write", "dynamicPath": true },
    { "match": "*io.file::delete", "class": "delete", "dynamicPath": true },
    { "match": "*io.directory::delete", "class": "delete", "dynamicPath": true },
    { "match": "*io.directory::getfiles", "class": "read", "dynamicPath": true },
    { "match": "*zipfile::*", "class": "write", "dynamicPath": true },
    { "match": "*reflection.assembly::load*", "class": "unknown" },
    { "match": "*process::start", "class": "unknown" },
    { "match": "*net.webclient*", "class": "download" },
    { "match": "*net.http*", "class": "download" },
    { "match": "*environment::setenvironmentvariable", "class": "persistence" },
    { "match": "*registry::*", "class": "persistence" }
  ],
  "dotnetDefault": "unknown",
  "cmdTable": {
    "read": ["echo", "dir", "type", "findstr", "where", "more", "tree", "ver", "vol", "date", "time", "set"],
    "cwd": ["cd", "chdir", "pushd", "popd"],
    "write": ["copy", "xcopy", "move", "ren", "rename", "md", "mkdir", "mklink"],
    "delete": ["del", "erase", "rd", "rmdir"],
    "system": ["reg", "sc", "netsh", "schtasks", "bcdedit", "diskpart", "shutdown", "format"],
    "privilege": ["icacls", "takeown", "attrib"],
    "execute-code": ["start", "call"]
  },
  "dynamic": {
    "ampersand-variable-unresolved": "dynamic",
    "iex-non-literal": "dynamic",
    "encoded-undecodable": "dynamic",
    "pwsh-inline-non-literal": "dynamic",
    "download-then-execute": "ASK DOWNLOAD-EXEC",
    "path-command-unresolved": "dynamic"
  },
  "pathParams": ["path", "literalpath", "filepath", "destination", "outfile", "outputfile", "destinationpath", "inputfile", "pspath", "workingdirectory", "root", "configuration", "from", "to"]
}
