{
  "tool": "git",
  "executables": ["git", "git.exe"],
  "providerHosts": ["github.com", "dev.azure.com", "visualstudio.com"],
  "source": "git/gh report (S4); verified in corpus: branch -D, push --force-with-lease, reset --hard, checkout --, worktree remove --force, --no-pager, -C; [I] clean, refspecs, config --global",
  "caseSensitive": true,
  "posix": true,
  "globalNoValue": ["--no-pager", "-P", "--paginate", "--no-optional-locks", "--bare", "--literal-pathspecs", "--no-replace-objects"],
  "globalWithValue": ["-C", "-c", "--git-dir", "--work-tree", "--namespace", "--exec-path"],
  "effectiveCwdFlags": ["-C"],
  "valueFlags": ["-m", "-F", "-b", "-B", "-t", "-u", "-o", "-c", "--message", "--file", "--source", "--format", "--sort", "--contains", "--author", "--date", "--since", "--until", "--grep", "-n", "--max-count", "--remote", "--depth", "--branch", "--upstream", "--set-upstream-to", "--recurse-submodules", "--reference", "--jobs", "-j"],
  "pathFlags": { "--output": "write" },
  "positionalPaths": false,
  "ops": [
    { "id": "git.read", "class": "read", "pos": ["status"] },
    { "id": "git.read.log", "class": "read", "pos": ["log"], "noFlag": ["--output", "--ext-diff", "--textconv", "--exec"] },
    { "id": "git.read.diff", "class": "read", "pos": ["diff"], "noFlag": ["--output", "--ext-diff", "--textconv", "--exec"] },
    { "id": "git.read.show", "class": "read", "pos": ["show"], "noFlag": ["--output", "--ext-diff", "--textconv", "--exec"] },
    { "id": "git.read.plumbing", "class": "read", "pos": ["rev-parse"] },
    { "id": "git.read.ls", "class": "read", "posPrefix": { "i": 0, "p": ["ls-files", "ls-tree", "merge-base", "check-ignore", "cat-file", "rev-list", "for-each-ref", "blame", "describe", "shortlog", "show-ref", "version", "help", "cherry", "count-objects", "diff-tree", "name-rev", "var", "show-branch", "whatchanged", "verify-commit", "verify-tag", "fsck"] }, "noFlag": ["--output"] },
    { "id": "git.read.grep", "class": "read", "pos": ["grep"], "noFlag": ["--open-files-in-pager", "-O"] },
    { "id": "git.read-output", "class": "write", "pos": ["log"], "anyFlag": ["--output"] },
    { "id": "git.read-output.diff", "class": "write", "pos": ["diff"], "anyFlag": ["--output"] },
    { "id": "git.read-external", "class": "unknown", "posPrefix": { "i": 0, "p": ["log", "diff", "show", "grep"] }, "anyFlag": ["--ext-diff", "--textconv", "--exec"] },
    { "id": "git.ls-remote", "class": "read-remote", "pos": ["ls-remote"] },
    { "id": "git.fetch.plain", "class": "read-remote", "pos": ["fetch"], "noFlag": ["-f", "--force"] },
    { "id": "git.fetch.force.remote-tracking", "class": "write", "pos": ["fetch"], "anyFlag": ["-f", "--force"] },
    { "id": "git.fetch.force.local-dest", "class": "history-rewrite", "pos": ["fetch"], "anyFlag": ["-f", "--force"], "posRegex": "^[^:]*:(?!refs/remotes/)" },
    { "id": "git.push", "class": "publish", "pos": ["push"] },
    { "id": "git.push.destructive", "class": "remote-destructive", "pos": ["push"], "anyFlag": ["-f", "--force", "--force-with-lease", "--force-if-includes", "--mirror", "--prune", "-d", "--delete"] },
    { "id": "git.push.refspec", "class": "remote-destructive", "pos": ["push"], "posRegex": "^[:+]" },
    { "id": "git.branch.list", "class": "read", "pos": ["branch"], "maxPos": 0 },
    { "id": "git.branch.list-flags", "class": "read", "pos": ["branch"], "anyFlag": ["-a", "-r", "-v", "-vv", "-l", "--list", "--contains", "--merged", "--no-merged", "--show-current", "--sort", "--format"] },
    { "id": "git.branch.create", "class": "write", "pos": ["branch"], "minPos": 1, "noFlag": ["-a", "-r", "-v", "-vv", "-l", "--list", "--contains", "--merged", "--no-merged", "--show-current", "--sort", "--format"] },
    { "id": "git.branch.rename-track", "class": "write", "pos": ["branch"], "anyFlag": ["-m", "-M", "-C", "--move", "--copy", "-u", "--set-upstream-to", "--unset-upstream", "--track"] },
    { "id": "git.branch.delete", "class": "delete", "pos": ["branch"], "anyFlag": ["-d", "--delete"] },
    { "id": "git.branch.force-delete", "class": "history-rewrite", "pos": ["branch"], "anyFlag": ["-D"] },
    { "id": "git.branch.force-move", "class": "history-rewrite", "pos": ["branch"], "anyFlag": ["-f", "--force"] },
    { "id": "git.tag.list", "class": "read", "pos": ["tag"], "anyFlag": ["-l", "--list", "-n", "--contains", "--no-contains", "--merged", "--no-merged", "--points-at", "--sort", "--format", "-v"] },
    { "id": "git.tag.create", "class": "write", "pos": ["tag"], "minPos": 1, "noFlag": ["-l", "--list", "-n", "--contains", "--merged", "--sort", "--format", "-v"] },
    { "id": "git.tag.delete", "class": "delete", "pos": ["tag"], "anyFlag": ["-d", "--delete"] },
    { "id": "git.tag.force", "class": "history-rewrite", "pos": ["tag"], "anyFlag": ["-f", "--force"] },
    { "id": "git.reset.hard", "class": "history-rewrite", "pos": ["reset"], "anyFlag": ["--hard", "--merge", "--keep"] },
    { "id": "git.reset.move", "class": "history-rewrite", "pos": ["reset"], "anyFlag": ["--soft", "--mixed"], "minPos": 1 },
    { "id": "git.reset.index-only", "class": "write", "pos": ["reset"], "noFlag": ["--hard", "--merge", "--keep", "--soft", "--mixed"], "maxPos": 0 },
    { "id": "git.reset.paths", "class": "write", "pos": ["reset"], "afterDD": true, "noFlag": ["--hard", "--merge", "--keep", "--soft", "--mixed"] },
    { "id": "git.commit", "class": "write", "pos": ["commit"], "noFlag": ["--amend", "--dry-run"] },
    { "id": "git.commit.amend", "class": "history-rewrite", "pos": ["commit"], "anyFlag": ["--amend"] },
    { "id": "git.commit.dry-run", "class": "read", "pos": ["commit"], "anyFlag": ["--dry-run"] },
    { "id": "git.rebase.continue", "class": "write", "pos": ["rebase"], "anyFlag": ["--continue", "--skip", "--abort"], "noFlag": ["--onto"] },
    { "id": "git.rebase", "class": "history-rewrite", "pos": ["rebase"], "noFlag": ["--continue", "--skip", "--abort"] },
    { "id": "git.merge.abort", "class": "history-rewrite", "pos": ["merge"], "anyFlag": ["--abort"] },
    { "id": "git.merge", "class": "write", "pos": ["merge"], "noFlag": ["--abort"] },
    { "id": "git.cherry-pick", "class": "write", "posPrefix": { "i": 0, "p": ["cherry-pick", "revert"] }, "noFlag": ["--abort"] },
    { "id": "git.cherry-pick.abort", "class": "history-rewrite", "posPrefix": { "i": 0, "p": ["cherry-pick", "revert"] }, "anyFlag": ["--abort"] },
    { "id": "git.checkout.paths", "class": "history-rewrite", "pos": ["checkout"], "afterDD": true },
    { "id": "git.checkout.force", "class": "history-rewrite", "pos": ["checkout"], "anyFlag": ["-f", "--force", "--discard-changes"] },
    { "id": "git.checkout.create", "class": "write", "pos": ["checkout"], "anyFlag": ["-b", "-B", "-t", "--orphan", "--detach"] },
    { "id": "git.switch.force", "class": "history-rewrite", "pos": ["switch"], "anyFlag": ["-f", "--force", "--discard-changes"] },
    { "id": "git.switch", "class": "write", "pos": ["switch"] },
    { "id": "git.restore.source", "class": "history-rewrite", "pos": ["restore"], "anyFlag": ["--source"] },
    { "id": "git.restore.staged", "class": "write", "pos": ["restore"], "anyFlag": ["--staged"], "noFlag": ["--worktree", "-W"] },
    { "id": "git.restore.worktree", "class": "history-rewrite", "pos": ["restore"], "noFlag": ["--staged"] },
    { "id": "git.stash.read", "class": "read", "posPrefix": { "i": 0, "p": ["stash"] }, "anyPos": ["list", "show"] },
    { "id": "git.stash.drop", "class": "history-rewrite", "pos": ["stash"], "anyPos": ["drop", "clear"] },
    { "id": "git.stash.write", "class": "write", "pos": ["stash"] },
    { "id": "git.worktree.list", "class": "read", "pos": ["worktree", "list"] },
    { "id": "git.worktree.write", "class": "write", "pos": ["worktree"], "anyPos": ["add", "lock", "unlock", "move", "repair"] },
    { "id": "git.worktree.prune", "class": "delete", "pos": ["worktree", "prune"] },
    { "id": "git.worktree.remove", "class": "delete", "pos": ["worktree", "remove"], "noFlag": ["--force", "-f"] },
    { "id": "git.worktree.remove-force", "class": "history-rewrite", "pos": ["worktree", "remove"], "anyFlag": ["--force", "-f"] },
    { "id": "git.clean.dry-run", "class": "read", "pos": ["clean"], "anyFlag": ["-n", "--dry-run"], "noFlag": ["-f", "--force"] },
    { "id": "git.clean.force", "class": "history-rewrite", "pos": ["clean"], "anyFlag": ["-f", "--force"] },
    { "id": "git.rm.cached", "class": "write", "pos": ["rm"], "anyFlag": ["--cached"] },
    { "id": "git.rm", "class": "delete", "pos": ["rm"], "noFlag": ["--cached"] },
    { "id": "git.pull.rebase", "class": "history-rewrite", "pos": ["pull"], "anyFlag": ["--rebase", "-r"] },
    { "id": "git.pull", "class": "write", "pos": ["pull"] },
    { "id": "git.add.dry-run", "class": "read", "pos": ["add"], "anyFlag": ["-n", "--dry-run"] },
    { "id": "git.add", "class": "write", "pos": ["add"], "noFlag": ["-n", "--dry-run"] },
    { "id": "git.mv", "class": "write", "posPrefix": { "i": 0, "p": ["mv", "clone", "init", "sparse-checkout", "am", "apply"] } },
    { "id": "git.config.read", "class": "read", "pos": ["config"], "anyFlag": ["--get", "--get-all", "--get-regexp", "--get-urlmatch", "--list", "-l", "--show-origin", "--show-scope", "--name-only"] },
    { "id": "git.config.single-key", "class": "read", "pos": ["config"], "maxPos": 1, "noFlag": ["--add", "--unset", "--unset-all", "--replace-all", "--rename-section", "--remove-section"] },
    { "id": "git.config.admin", "class": "admin", "pos": ["config"], "anyFlag": ["--global", "--system"], "minPos": 2 },
    { "id": "git.config.write-local", "class": "write", "pos": ["config"], "noFlag": ["--global", "--system", "-e", "--edit"], "minPos": 2 },
    { "id": "git.config.edit", "class": "unknown", "pos": ["config"], "anyFlag": ["-e", "--edit"] },
    { "id": "git.symbolic-ref.read", "class": "read", "pos": ["symbolic-ref"], "maxPos": 1, "noFlag": ["-d", "--delete"] },
    { "id": "git.symbolic-ref.write", "class": "write", "pos": ["symbolic-ref"], "minPos": 2 },
    { "id": "git.remote.read", "class": "read", "pos": ["remote"], "maxPos": 0 },
    { "id": "git.remote.network", "class": "read-remote", "pos": ["remote"], "anyPos": ["show", "update"] },
    { "id": "git.remote.prune", "class": "delete", "pos": ["remote", "prune"] },
    { "id": "git.remote.change", "class": "admin", "pos": ["remote"], "anyPos": ["add", "rename", "remove", "rm", "set-url", "set-head", "set-branches"] },
    { "id": "git.reflog.read", "class": "read", "pos": ["reflog"], "anyPos": ["show"] },
    { "id": "git.reflog.read0", "class": "read", "pos": ["reflog"], "maxPos": 0 },
    { "id": "git.reflog.rewrite", "class": "history-rewrite", "pos": ["reflog"], "anyPos": ["expire", "delete"] },
    { "id": "git.update-ref", "class": "history-rewrite", "pos": ["update-ref"] },
    { "id": "git.gc", "class": "delete", "posPrefix": { "i": 0, "p": ["gc", "prune"] } },
    { "id": "git.submodule.write", "class": "write", "pos": ["submodule"], "anyPos": ["init", "update", "add", "sync"] },
    { "id": "git.submodule.deinit", "class": "delete", "pos": ["submodule", "deinit"] },
    { "id": "git.hash-object.write", "class": "write", "pos": ["hash-object"], "anyFlag": ["-w"] },
    { "id": "git.hash-object", "class": "read", "pos": ["hash-object"] },
    { "id": "git.archive.file", "class": "write", "pos": ["archive"], "anyFlag": ["-o", "--output"] },
    { "id": "git.archive", "class": "read", "pos": ["archive"] },
    { "id": "git.sparse-checkout.read", "class": "read", "pos": ["sparse-checkout", "list"] },
    { "id": "git.sparse-checkout", "class": "write", "pos": ["sparse-checkout"] },
    { "id": "git.config-override-deny", "class": "unknown", "flagValueRegex": { "-c": "^(core\\.(hookspath|sshcommand|fsmonitor|pager|editor|askpass)|credential\\.|alias\\.|gpg\\.program|diff\\.external|protocol\\.|url\\.|include\\.)" } }
  ],
  "default": "unknown"
}
