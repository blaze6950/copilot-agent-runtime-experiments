{
  "tool": "dotnet",
  "executables": ["dotnet", "dotnet.exe", "dotnet-script", "dotnet-script.exe"],
  "source": "dotnet/python/node report (S4): test/build/run = execute-code (repo); add package/restore = install (fixes the false SAFE on dotnet add); tool install --global = install; [I] publish/nuget push/ef database",
  "caseSensitive": true,
  "posix": false,
  "globalNoValue": ["--nologo", "-v", "--verbosity", "-q", "--no-restore", "--no-build", "--no-incremental", "--no-dependencies", "--interactive"],
  "globalWithValue": [],
  "valueFlags": ["-c", "--configuration", "-f", "--framework", "-r", "--runtime", "-o", "--output", "-p", "--property", "-t", "--target", "--filter", "--logger", "--settings", "--source", "-s", "--add-source", "--version", "--project", "-e", "--global", "--tool-path", "--prerelease", "--version-suffix", "--maxcpucount", "-m", "--arch", "--os", "--os-version", "--packages", "--locale"],
  "pathFlags": { "--output": "write", "-o": "write", "--packages": "write", "--tool-path": "write" },
  "positionalPaths": true,
  "ops": [
    { "id": "dotnet.info-flags", "class": "read", "maxPos": 0, "anyFlag": ["--version", "--info", "--list-sdks", "--list-runtimes"] },
    { "id": "dotnet.info", "class": "read", "posPrefix": { "i": 0, "p": ["version", "info", "list-sdks", "list-runtimes"] } },
    { "id": "dotnet.ef.database", "class": "admin", "pos": ["ef"], "anyPos": ["database", "dbcontext"] },
    { "id": "dotnet.nuget.push", "class": "publish", "pos": ["nuget", "push"] },
    { "id": "dotnet.nuget.locals-clear", "class": "unknown", "pos": ["nuget", "locals"], "anyFlag": ["--clear"] },
    { "id": "dotnet.nuget.read", "class": "read", "pos": ["nuget"], "anyPos": ["list", "locals"] },
    { "id": "dotnet.tool.global", "class": "install", "pos": ["tool"], "anyPos": ["install", "update", "uninstall"], "anyFlag": ["--global", "-g"] },
    { "id": "dotnet.tool.run", "class": "execute-code", "pos": ["tool", "run"] },
    { "id": "dotnet.tool.project", "class": "install", "pos": ["tool"], "anyPos": ["install", "restore", "update", "uninstall"] },
    { "id": "dotnet.tool.list", "class": "read", "pos": ["tool", "list"] },
    { "id": "dotnet.script.version", "class": "read", "pos": ["script"], "anyFlag": ["--version"] },
    { "id": "dotnet.script.inline", "class": "execute-code", "execKind": "inline", "posPrefix": { "i": 0, "p": ["script", "csi"] }, "anyFlag": ["-e"] },
    { "id": "dotnet.script.file", "class": "execute-code", "execKind": "script", "pos": ["script"] },
    { "id": "dotnet.exec-publish-target", "class": "publish", "posPrefix": { "i": 0, "p": ["build", "test", "run", "publish"] }, "flagValueRegex": { "-t": "publish|deploy", "--target": "publish|deploy", "-p": "publishprofile" } },
    { "id": "dotnet.build-test", "class": "execute-code", "execKind": "build", "posPrefix": { "i": 0, "p": ["build", "test"] } },
    { "id": "dotnet.exec", "class": "execute-code", "posPrefix": { "i": 0, "p": ["run", "publish", "csi"] } },
    { "id": "dotnet.restore", "class": "install", "pos": ["restore"], "execKind": "build" },
    { "id": "dotnet.restore-source", "class": "unknown", "posPrefix": { "i": 0, "p": ["restore", "add"] }, "anyFlag": ["--source", "-s", "--add-source"] },
    { "id": "dotnet.add", "class": "install", "pos": ["add"] },
    { "id": "dotnet.clean", "class": "delete", "pos": ["clean"], "execKind": "build" },
    { "id": "dotnet.write", "class": "write", "posPrefix": { "i": 0, "p": ["new", "sln", "pack", "format"] } },
    { "id": "dotnet.ef.migrations", "class": "write", "pos": ["ef"], "anyPos": ["migrations"] }
  ],
  "default": "unknown"
}
