{
  "tool": "gh",
  "executables": ["gh", "gh.exe"],
  "providerHosts": ["github.com", "api.github.com"],
  "source": "git/gh report (S4): gh api method defaults and implicit POST (verified via gh api --help in the report); GraphQL mutation text; [I] admin/secret/variable verbs",
  "caseSensitive": true,
  "posix": false,
  "globalNoValue": ["--version", "--help"],
  "globalWithValue": ["-R", "--repo", "--hostname"],
  "effectiveCwdFlags": [],
  "valueFlags": ["-X", "--method", "-f", "-F", "--raw-field", "--field", "--input", "-H", "--header", "-q", "--jq", "-t", "--template", "-R", "--repo", "--hostname", "-L", "--limit", "-s", "--state", "-b", "--body", "-F", "--body-file", "-t", "--title", "-B", "--base", "-H", "--head", "-l", "--label", "-a", "--assignee", "-w", "--workflow", "-o", "--output", "-r", "--ref", "--json", "-p", "--paginate-field"],
  "pathFlags": { "--output": "write", "-o": "write" },
  "positionalPaths": false,
  "ops": [
    { "id": "gh.read.common", "class": "read-remote", "posPrefix": { "i": 0, "p": ["search"] } },
    { "id": "gh.read.pr", "class": "read-remote", "pos": ["pr"], "anyPos": ["view", "list", "status", "checks", "diff"] },
    { "id": "gh.read.issue", "class": "read-remote", "pos": ["issue"], "anyPos": ["view", "list", "status"] },
    { "id": "gh.read.repo-run-release", "class": "read-remote", "posPrefix": { "i": 0, "p": ["repo", "run", "release", "gist", "workflow", "cache", "ruleset", "org", "label", "codespace"] }, "anyPos": ["view", "list", "status"] },
    { "id": "gh.read.top", "class": "read-remote", "posPrefix": { "i": 0, "p": ["status", "version", "help"] } },
    { "id": "gh.auth.status", "class": "read-remote", "pos": ["auth", "status"], "noFlag": ["-t", "--show-token"] },
    { "id": "gh.auth.token", "class": "credential", "pos": ["auth", "token"] },
    { "id": "gh.auth.status-token", "class": "credential", "pos": ["auth", "status"], "anyFlag": ["-t", "--show-token"] },
    { "id": "gh.auth.change", "class": "admin", "pos": ["auth"], "anyPos": ["switch", "login", "logout", "refresh"] },
    { "id": "gh.write-local", "class": "write", "pos": ["pr"], "anyPos": ["checkout"] },
    { "id": "gh.clone", "class": "write", "pos": ["repo", "clone"] },
    { "id": "gh.publish", "class": "publish", "pos": ["pr"], "anyPos": ["create", "edit", "comment", "close", "reopen", "ready", "review", "update-branch", "merge"] },
    { "id": "gh.pr.merge.delete-branch", "class": "remote-destructive", "pos": ["pr", "merge"], "anyFlag": ["--delete-branch"] },
    { "id": "gh.pr.merge.admin", "class": "admin", "pos": ["pr", "merge"], "anyFlag": ["--admin"] },
    { "id": "gh.publish.issue", "class": "publish", "pos": ["issue"], "anyPos": ["create", "comment", "edit", "close", "reopen"] },
    { "id": "gh.publish.misc", "class": "publish", "posPrefix": { "i": 0, "p": ["gist", "release", "label"] }, "anyPos": ["create", "edit", "upload", "comment"] },
    { "id": "gh.publish.repo-create", "class": "publish", "pos": ["repo", "create"] },
    { "id": "gh.delete", "class": "remote-destructive", "posPrefix": { "i": 0, "p": ["repo", "release", "gist", "secret", "variable", "cache", "ssh-key", "codespace", "label"] }, "anyPos": ["delete", "delete-asset"] },
    { "id": "gh.admin", "class": "admin", "posPrefix": { "i": 0, "p": ["secret", "variable", "repo", "workflow", "run", "extension", "alias", "config", "ruleset"] }, "anyPos": ["set", "edit", "archive", "run", "enable", "disable", "rerun", "cancel", "install", "remove", "create"] },
    { "id": "gh.api.delete", "class": "remote-destructive", "pos": ["api"], "flagIn": { "-X": ["DELETE"], "--method": ["DELETE"] } },
    { "id": "gh.api.write", "class": "admin", "pos": ["api"], "flagIn": { "-X": ["POST", "PUT", "PATCH"], "--method": ["POST", "PUT", "PATCH"] } },
    { "id": "gh.api.implicit-post", "class": "admin", "pos": ["api"], "noFlag": ["-X", "--method"], "anyFlag": ["-f", "-F", "--raw-field", "--field", "--input"] },
    { "id": "gh.api.method-nonconst", "class": "unknown", "pos": ["api"], "flagNonConst": ["-X", "--method"] },
    { "id": "gh.api.get", "class": "read-remote", "pos": ["api"] },
    { "id": "gh.api.graphql.mutation", "class": "admin", "pos": ["api", "graphql"], "flagValueRegex": { "-f": "mutation", "-F": "mutation" } },
    { "id": "gh.api.graphql.nonconst", "class": "unknown", "pos": ["api", "graphql"], "flagNonConst": ["-f", "-F"] },
    { "id": "gh.api.graphql.read", "class": "read-remote", "pos": ["api", "graphql"] }
  ],
  "default": "unknown"
}
