{
  "tool": "az",
  "executables": ["az", "az.cmd"],
  "providerHosts": ["management.azure.com", "graph.microsoft.com", "login.microsoftonline.com", "dev.azure.com", "visualstudio.com"],
  "source": "cloud/infra report (S4): verb table on the leaf token (any positional); az rest / devops invoke values (--method, --http-method) decide class; [V] get-access-token 124 clusters, az rest --method patch, az devops invoke PATCH, az extension add; secret-returning reads (keyvault secret show/download, keyvault key/certificate download, list-keys, keys list) = credential (D-28)",
  "caseSensitive": false,
  "posix": false,
  "valueFlags": ["--name", "-n", "--resource-group", "-g", "--subscription", "--output", "-o", "--query", "--url", "--uri", "--method", "--body", "--uri-parameters", "--url-parameters", "--headers", "--resource", "--area", "--org", "--project", "--http-method", "--in-file", "--out-file", "--api-version", "--location", "-l", "--tenant", "--scope", "--sku", "--value", "--file", "--target"],
  "pathFlags": { "--out-file": "write", "--in-file": "read", "--file": "read" },
  "positionalPaths": false,
  "ops": [
    { "id": "az.help", "class": "read", "anyFlag": ["--help", "-h"] },
    { "id": "az.token", "class": "credential", "anyPos": ["get-access-token"] },
    { "id": "az.keyvault.secret-read", "class": "credential", "pos": ["keyvault", "secret"], "anyPos": ["show", "download"] },
    { "id": "az.keyvault.key-download", "class": "credential", "pos": ["keyvault", "key"], "anyPos": ["download"] },
    { "id": "az.keyvault.certificate-download", "class": "credential", "pos": ["keyvault", "certificate"], "anyPos": ["download"] },
    { "id": "az.list-keys", "class": "credential", "anyPos": ["list-keys"] },
    { "id": "az.keys-list", "class": "credential", "anyPos": ["keys"], "posRegex": "^list$" },
    { "id": "az.account.set", "class": "auth", "pos": ["account"], "anyPos": ["set", "clear"] },
    { "id": "az.login", "class": "auth", "anyPos": ["login", "logout"] },
    { "id": "az.devops.configure", "class": "auth", "pos": ["devops"], "anyPos": ["configure"], "noFlag": ["--list"] },
    { "id": "az.extension", "class": "install", "pos": ["extension"], "anyPos": ["add", "remove", "update"] },
    { "id": "az.rest.get", "class": "read-remote", "pos": ["rest"], "noFlag": ["--method"] },
    { "id": "az.rest.method-read", "class": "read-remote", "pos": ["rest"], "flagIn": { "--method": ["GET", "HEAD"] } },
    { "id": "az.rest.method-write", "class": "remote-write", "pos": ["rest"], "flagIn": { "--method": ["POST", "PUT", "PATCH"] } },
    { "id": "az.rest.method-delete", "class": "remote-destructive", "pos": ["rest"], "flagIn": { "--method": ["DELETE"] } },
    { "id": "az.rest.method-nonconst", "class": "unknown", "pos": ["rest"], "flagNonConst": ["--method"] },
    { "id": "az.devops.invoke.get", "class": "read-remote", "pos": ["devops", "invoke"], "noFlag": ["--http-method"] },
    { "id": "az.devops.invoke.read", "class": "read-remote", "pos": ["devops", "invoke"], "flagIn": { "--http-method": ["GET", "HEAD"] } },
    { "id": "az.devops.invoke.write", "class": "remote-write", "pos": ["devops", "invoke"], "flagIn": { "--http-method": ["POST", "PUT", "PATCH"] } },
    { "id": "az.devops.invoke.delete", "class": "remote-destructive", "pos": ["devops", "invoke"], "flagIn": { "--http-method": ["DELETE"] } },
    { "id": "az.devops.invoke.nonconst", "class": "unknown", "pos": ["devops", "invoke"], "flagNonConst": ["--http-method"] },
    { "id": "az.pipelines.run", "class": "publish", "pos": ["pipelines"], "anyPos": ["run", "queue"] },
    { "id": "az.delete", "class": "remote-destructive", "anyPos": ["delete", "purge", "remove"] },
    { "id": "az.write", "class": "remote-write", "anyPos": ["create", "update", "set", "add", "import", "upload", "approve", "reject", "move", "restore", "stop", "restart"] },
    { "id": "az.read", "class": "read-remote", "anyPos": ["list", "show", "query", "version", "search", "info", "status", "tail"] }
  ],
  "default": "unknown"
}
