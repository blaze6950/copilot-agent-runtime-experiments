{
  "_about": "Directory policy of the shell governor (T4). Levels: normal (access per allow), protected (write/delete/execute ASK; reads allowed), secret (any access ASK; wins over every other rule). A normal rule with exceptionTo may open an intent of a protected rule. Placeholders resolved by the config store: {home} {temp} {appdata} {localappdata} {copilotHome}; {sessionId} is resolved per session (no valid session id = the rule never matches). gate script-freshness: execute only when the script existed before this session. repo: the git repo root of the effective cwd, only under a configured code root. Agent overrides may tighten rules; protected and secret rules cannot be loosened. Persistence locations (Startup folders, PowerShell profile folders incl. OneDrive-redirected Documents, .git\\hooks, scheduled tasks) are protected. Protected and secret rules match paths by canonical form and real location (8.3 names, junctions, links); normal rules, including repo, match only their written form; see lib/paths.mjs. Rules session-state-plan, session-state-impl and reports are normal work areas: read and write are allowed (exceptions to copilot-home for those two intents only), delete and execute stay protected. Links can only add restrictions: normal rules match only their written pattern; protected and secret rules also match through resolved links.",
  "rules": [
    { "id": "repo", "repo": true, "level": "normal", "allow": ["read", "write", "delete", "execute"] },
    { "id": "temp", "pattern": "{temp}\\**", "level": "normal", "allow": ["read", "write", "delete", "execute"] },
    { "id": "session-files", "pattern": "{copilotHome}\\session-state\\{sessionId}\\files\\**", "level": "normal", "allow": ["read", "write"], "exceptionTo": "copilot-home" },
    { "id": "session-state-plan", "pattern": "{copilotHome}\\session-state\\{sessionId}\\plan.md", "level": "normal", "allow": ["read", "write"], "exceptionTo": "copilot-home", "exceptionIntents": ["read", "write"] },
    { "id": "session-state-impl", "pattern": "{copilotHome}\\session-state\\{sessionId}\\implementation-state.md", "level": "normal", "allow": ["read", "write"], "exceptionTo": "copilot-home", "exceptionIntents": ["read", "write"] },
    { "id": "reports", "pattern": "{copilotHome}\\reports\\**", "level": "normal", "allow": ["read", "write"], "exceptionTo": "copilot-home", "exceptionIntents": ["read", "write"] },
    { "id": "session-scripts", "pattern": "{copilotHome}\\session-state\\scripts\\**", "level": "normal", "allow": ["read", "execute"], "exceptionTo": "copilot-home", "exceptionIntents": ["read", "execute"], "gate": "script-freshness" },
    { "id": "startup-user", "pattern": "{appdata}\\Microsoft\\Windows\\Start Menu\\Programs\\Startup\\**", "level": "protected", "allow": ["read"] },
    { "id": "startup-all-users", "pattern": "C:\\ProgramData\\Microsoft\\Windows\\Start Menu\\Programs\\StartUp\\**", "level": "protected", "allow": ["read"] },
    { "id": "powershell-profile", "pattern": "{home}\\Documents\\PowerShell\\**", "level": "protected", "allow": ["read"] },
    { "id": "windows-powershell-profile", "pattern": "{home}\\Documents\\WindowsPowerShell\\**", "level": "protected", "allow": ["read"] },
    { "id": "powershell-profile-onedrive", "pattern": "{home}\\OneDrive*\\Documents\\PowerShell\\**", "level": "protected", "allow": ["read"] },
    { "id": "windows-powershell-profile-onedrive", "pattern": "{home}\\OneDrive*\\Documents\\WindowsPowerShell\\**", "level": "protected", "allow": ["read"] },
    { "id": "git-hooks", "pattern": "**\\.git\\hooks\\**", "level": "protected", "allow": ["read"] },
    { "id": "scheduled-tasks", "pattern": "C:\\Windows\\System32\\Tasks\\**", "level": "protected", "allow": ["read"] },
    { "id": "governor-logs", "pattern": "{copilotHome}\\extensions\\shell-governor\\logs\\**", "level": "secret", "allow": [] },
    { "id": "governor-reviews", "pattern": "{copilotHome}\\extensions\\shell-governor\\reviews\\**", "level": "secret", "allow": [] },
    { "id": "governor-local", "pattern": "{copilotHome}\\extensions\\shell-governor\\.local\\**", "level": "secret", "allow": [] },
    { "id": "governor-own", "pattern": "{copilotHome}\\extensions\\**", "level": "protected", "allow": ["read"] },
    { "id": "copilot-home", "pattern": "{copilotHome}\\**", "level": "protected", "allow": ["read"] },
    { "id": "windows", "pattern": "C:\\Windows\\**", "level": "protected", "allow": ["read"] },
    { "id": "program-files", "pattern": "C:\\Program Files*\\**", "level": "protected", "allow": ["read"] },
    { "id": "programdata", "pattern": "C:\\ProgramData\\**", "level": "protected", "allow": ["read"] },

    { "id": "secret-ssh", "pattern": "{home}\\.ssh\\**", "level": "secret", "allow": [] },
    { "id": "secret-aws", "pattern": "{home}\\.aws\\**", "level": "secret", "allow": [] },
    { "id": "secret-kube", "pattern": "{home}\\.kube\\**", "level": "secret", "allow": [] },
    { "id": "secret-azure", "pattern": "{home}\\.azure\\**", "level": "secret", "allow": [] },
    { "id": "secret-mcp", "pattern": "{copilotHome}\\mcp-secrets\\**", "level": "secret", "allow": [] },
    { "id": "secret-entra", "pattern": "{copilotHome}\\entra-broker*\\**", "level": "secret", "allow": [] },
    { "id": "secret-pem", "pattern": "**\\*.pem", "level": "secret", "allow": [] },
    { "id": "secret-pfx", "pattern": "**\\*.pfx", "level": "secret", "allow": [] },
    { "id": "secret-key", "pattern": "**\\*.key", "level": "secret", "allow": [] },
    { "id": "secret-env", "pattern": "**\\.env", "level": "secret", "allow": [] },
    { "id": "secret-npmrc", "pattern": "**\\.npmrc", "level": "secret", "allow": [] },
    { "id": "secret-netrc", "pattern": "**\\.netrc", "level": "secret", "allow": [] },
    { "id": "secret-gitcred", "pattern": "**\\.git-credentials", "level": "secret", "allow": [] },

    { "id": "s6-usersecrets", "pattern": "{appdata}\\Microsoft\\UserSecrets\\**", "level": "secret", "allow": [] },
    { "id": "s6-gh-hosts", "pattern": "{home}\\.config\\gh\\hosts.yml", "level": "secret", "allow": [] },
    { "id": "s6-docker-config", "pattern": "{home}\\.docker\\config.json", "level": "secret", "allow": [] },
    { "id": "s6-nuget-home", "pattern": "{home}\\.nuget\\NuGet\\NuGet.Config", "level": "secret", "allow": [] },
    { "id": "s6-nuget-appdata", "pattern": "{appdata}\\NuGet\\NuGet.Config", "level": "secret", "allow": [] },
    { "id": "s6-copilot-config", "pattern": "{copilotHome}\\config.json", "level": "secret", "allow": [] },
    { "id": "s6-copilot-mcp-config", "pattern": "{copilotHome}\\mcp-config.json", "level": "secret", "allow": [] },
    { "id": "s6-copilot-mcp-oauth", "pattern": "{copilotHome}\\mcp-oauth-config\\**", "level": "secret", "allow": [] },
    { "id": "s6-copilot-permissions", "pattern": "{copilotHome}\\permissions-config.json", "level": "secret", "allow": [] },
    { "id": "s6-home-netrc", "pattern": "{home}\\.netrc", "level": "secret", "allow": [] },
    { "id": "s6-home-npmrc", "pattern": "{home}\\.npmrc", "level": "secret", "allow": [] },
    { "id": "s6-home-pypirc", "pattern": "{home}\\.pypirc", "level": "secret", "allow": [] },
    { "id": "s6-home-git-credentials", "pattern": "{home}\\.git-credentials", "level": "secret", "allow": [] },
    { "id": "s6-home-azure", "pattern": "{home}\\.azure\\**", "level": "secret", "allow": [] },
    { "id": "s6-home-ssh", "pattern": "{home}\\.ssh\\**", "level": "secret", "allow": [] },
    { "id": "s6-publishsettings", "pattern": "**\\*.publishsettings", "level": "secret", "allow": [] },
    { "id": "s6-p12", "pattern": "**\\*.p12", "level": "secret", "allow": [] },
    { "id": "s6-env-variants", "pattern": "**\\.env.*", "level": "secret", "allow": [] },
    { "id": "s6-chrome-profile", "pattern": "{localappdata}\\Google\\Chrome\\User Data\\**", "level": "secret", "allow": [] },
    { "id": "s6-edge-profile", "pattern": "{localappdata}\\Microsoft\\Edge\\User Data\\**", "level": "secret", "allow": [] },
    { "id": "s6-firefox-profile", "pattern": "{appdata}\\Mozilla\\Firefox\\Profiles\\**", "level": "secret", "allow": [] },
    { "id": "s6-cred-local", "pattern": "{localappdata}\\Microsoft\\Credentials\\**", "level": "secret", "allow": [] },
    { "id": "s6-cred-roaming", "pattern": "{appdata}\\Microsoft\\Credentials\\**", "level": "secret", "allow": [] },
    { "id": "s6-vault", "pattern": "{localappdata}\\Microsoft\\Vault\\**", "level": "secret", "allow": [] }
  ]
}
